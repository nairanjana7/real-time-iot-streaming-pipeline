.dashboard-page {
  min-height: 100vh;
  background: #0b1626;
  color: #f4f7fb;
}

.dashboard-topbar {
  height: 52px;
  border-bottom: 1px solid #26374b;
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  padding: 0 22px;
  color: #8ea4bd;
  font-size: 12px;
}

.dashboard-dots {
  display: flex;
  gap: 7px;
}

.dashboard-dots span {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #60758d;
}

.dashboard-breadcrumb {
  color: #6e9bc5;
}

.dashboard-breadcrumb span {
  margin: 0 6px;
  color: #43586e;
}

.live-indicator {
  justify-self: end;
  display: flex;
  align-items: center;
  gap: 6px;
  color: #78b8df;
  font-weight: 600;
  letter-spacing: 0.04em;
}

.dashboard-content {
  padding: 30px 24px 45px;
  max-width: 1180px;
  margin: 0 auto;
}

.dashboard-heading {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 28px;
}

.eyebrow {
  margin: 0 0 8px;
  color: #7892ad;
  font-size: 13px;
}

.dashboard-heading h1 {
  margin: 0;
  font-size: 25px;
  font-weight: 650;
  letter-spacing: -0.02em;
}

.dashboard-actions {
  display: flex;
  align-items: center;
  gap: 20px;
  color: #7892ad;
  font-size: 13px;
}

.dashboard-actions button,
.dashboard-error button {
  border: 1px solid #52667c;
  background: transparent;
  color: #dce7f1;
  padding: 8px 13px;
  display: flex;
  align-items: center;
  gap: 7px;
  cursor: pointer;
  font: inherit;
}

.dashboard-actions button:hover,
.dashboard-error button:hover {
  background: #14263b;
}

.dashboard-actions button:disabled {
  opacity: 0.6;
  cursor: default;
}

.health-summary {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  border: 1px solid #293c51;
  margin-bottom: 30px;
}

.health-stat {
  min-height: 100px;
  padding: 18px;
  border-right: 1px solid #293c51;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.health-stat:last-child {
  border-right: none;
}

.health-stat span {
  color: #7892ad;
  font-size: 12px;
}

.health-stat strong {
  font-size: 24px;
  font-weight: 650;
}

.health-stat:nth-child(2) strong {
  color: #67aee0;
}

.health-stat:nth-child(3) strong {
  color: #e0a24b;
}

.health-stat:nth-child(4) strong {
  color: #e36b6b;
}

.machine-panel {
  border: 1px solid #293c51;
  background: #0d1a2b;
}

.machine-table {
  width: 100%;
}

.machine-row {
  min-height: 50px;
  display: grid;
  grid-template-columns: 1.25fr 1fr 1fr 1.2fr;
  align-items: center;
  padding: 0 17px;
  border-bottom: 1px solid #293c51;
  font-size: 13px;
  color: #d2deea;
}

.machine-row:last-child {
  border-bottom: none;
}

.machine-header {
  min-height: 45px;
  color: #7892ad;
  font-size: 11px;
  background: #0b1727;
}

.machine-name {
  color: #f5f8fb;
  font-weight: 600;
}

.machine-status {
  font-weight: 600;
}

.machine-status.normal {
  color: #6db2e2;
}

.machine-status.warning {
  color: #e0a24b;
}

.machine-status.critical {
  color: #e36b6b;
}

.empty-state {
  padding: 55px 18px;
  text-align: center;
  color: #7892ad;
}

.empty-state strong {
  display: block;
  color: #f1f5f9;
  font-size: 17px;
  margin-bottom: 8px;
}

.empty-state p {
  margin: 0;
  font-size: 13px;
}

.dashboard-error {
  border: 1px solid #75434a;
  background: #211820;
  padding: 14px 16px;
  margin-bottom: 22px;
  display: flex;
  align-items: center;
  gap: 15px;
  color: #e9b5b5;
  font-size: 13px;
}

.dashboard-error strong {
  color: #f0d4d4;
}

.dashboard-error span {
  flex: 1;
}

.dashboard-error button {
  padding: 6px 12px;
}

.dashboard-footer {
  max-width: 1180px;
  margin: 0 auto;
  padding: 0 24px 18px;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 12px;
  color: #607892;
  font-size: 12px;
}

.dashboard-footer span {
  width: 36px;
  height: 1px;
  background: #526a81;
}

.spin {
  animation: dashboard-spin 1s linear infinite;
}

@keyframes dashboard-spin {
  to {
    transform: rotate(360deg);
  }
}

@media (max-width: 800px) {
  .dashboard-topbar {
    grid-template-columns: auto 1fr auto;
  }

  .dashboard-breadcrumb {
    justify-self: center;
  }

  .dashboard-content {
    padding: 24px 15px;
  }

  .dashboard-heading {
    gap: 20px;
  }

  .health-summary {
    grid-template-columns: repeat(2, 1fr);
  }

  .health-stat:nth-child(2) {
    border-right: none;
  }

  .machine-row {
    grid-template-columns: 1.2fr 1fr 1fr;
  }

  .machine-row span:last-child {
    display: none;
  }
}
